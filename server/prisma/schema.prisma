generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id            String   @id @default(cuid())
  pcNumber      String   @unique
  phone         String   @unique
  email         String?
  name          String
  pathway       String
  location      String
  status        String   @default("ACTIVE")
  identityNumber String?
  photoPath      String?
  dateOfBirth     DateTime?
  sex             String?
  subCounty       String?
  village         String?
  maritalStatus   String?
  occupation      String?
  pinHash       String
  resetToken    String?
  isReviewer    Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  resetExpires  DateTime?
  assistedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  endorsements   Endorsement[]
  auditAsActor   AuditLog[]    @relation("AuditActor")
  reviewsReceived ReviewDecision[] @relation("ReviewTarget")
  reviewsMade     ReviewDecision[] @relation("ReviewAuthor")
  auditAsTarget  AuditLog[]    @relation("AuditTarget")

  @@index([status])
  consents          Consent[]
  correctionTickets CorrectionTicket[]
}

model Endorsement {
  id         String   @id @default(cuid())
  memberId   String?
  name       String
  phone      String?
  assistedBy String?
  createdAt  DateTime @default(now())

  member Member? @relation(fields: [memberId], references: [id])

  @@index([assistedBy])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorPc   String
  targetPc  String?
  meta      String?
  createdAt DateTime @default(now())

  actor  Member? @relation("AuditActor",  fields: [actorPc],  references: [pcNumber])
  target Member? @relation("AuditTarget", fields: [targetPc], references: [pcNumber])

  @@index([action])
  @@index([actorPc])
}

model PatrioticOfficer {
  id       String @id @default(cuid())
  poNumber String @unique
  name     String
  role     String
  location String
  status        String   @default("ACTIVE")
  identityNumber String?
  photoPath      String?
  dateOfBirth     DateTime?
  sex             String?
  subCounty       String?
  village         String?
  maritalStatus   String?
  occupation      String?
}

model ReviewDecision {
  id          String   @id @default(cuid())
  memberId    String
  reviewerId  String
  decision    String
  reason      String?
  createdAt   DateTime @default(now())

  member   Member @relation("ReviewTarget", fields: [memberId],   references: [id])
  reviewer Member @relation("ReviewAuthor", fields: [reviewerId], references: [id])

  @@index([memberId])
  @@index([reviewerId])
}



model CorruptionReport {
  id           String   @id @default(cuid())
  trackingCode String   @unique
  category     String
  description  String
  location     String
  reporterName String?
  reporterPhone String?
  isAnonymous  Boolean  @default(false)
  evidenceNote String?
  evidencePath String?
  status        String   @default("RECEIVED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([trackingCode])
}






model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  startAt     DateTime
  endAt       DateTime?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rsvps EventRSVP[]

  @@index([startAt])
}

model EventRSVP {
  id         String   @id @default(cuid())
  eventId    String
  memberId   String?
  name       String
  phone      String
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, phone])
  @@index([eventId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  keys       String
  memberId   String
  createdAt  DateTime @default(now())

  @@index([memberId])
}



model Consent {
  id         String   @id @default(uuid())
  memberId   String
  scope      String
  granted    Boolean
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id])
}

model CorrectionTicket {
  id         String   @id @default(uuid())
  memberId   String
  field      String
  newValue   String
  reason     String?
  status        String   @default("open")
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id])
}


// Idempotency records ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â prevents duplicate members on retry.
// Standard: IETF draft-ietf-httpapi-idempotency-key-header
model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  responseBody Json
  statusCode   Int      @default(200)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  @@index([expiresAt])
}
